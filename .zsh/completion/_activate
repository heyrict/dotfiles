#compdef activate

_activate() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    _arguments "${_arguments_options[@]}" $common \
        '*: :->args' \
        && ret=0

    case "$state" in
        args)
            local lastarg=${words[${#words}]}
            local filepath="${HOME}/"
            _arguments -s -S $common "*:: :_files -W $filepath"
        ;;
    esac

    return ret
}
