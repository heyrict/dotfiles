% db.pg.dump

# Dump postgresql database to file
pg_dump <dbname> | gzip > <outfile>.gz


% db.pg.restore

# Restore postgresql database from file
gunzip -c <filename> | psql <dbname>

$ filename: ls


% db.duckdb.myduckserver

# Spawn up a myduckserver container given a database file
tmpdir=$(mktemp -dp /tmp)
cp <duckdb_file> $tmpdir/myduck.db
docker run -p 13306:3306 -p 15432:5432 --volume=$tmpdir:/home/admin/data apecloud/myduckserver:latest

$ duckdb_file: ls
